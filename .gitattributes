# Shell scripts must keep LF so they run on Linux/macOS/Termux.
*.sh text eol=lf

# Source, docs and data stay LF.
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yaml text eol=lf

# PowerShell scripts keep CRLF on Windows checkouts.
*.ps1 text eol=crlf

# Batch launchers keep CRLF too. Keep them ASCII-only: cmd.exe mis-parses
# non-ASCII batch files under chcp 65001.
*.bat text eol=crlf
